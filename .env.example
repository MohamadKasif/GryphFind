# Leave SNOWFLAKE_* unset to run fully locally on SQLite.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=GRYPHFIND
SNOWFLAKE_SCHEMA=PUBLIC
# Open-weight model used by Cortex COMPLETE for match explanations
CORTEX_MODEL=llama3.1-8b

# Optional local open-weight LLM for explanations when not using Snowflake
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# CLIP_MODEL=openai/clip-vit-base-patch32
# PORT=8000
